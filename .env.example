# Banco local com dados fictícios, usado como default seguro em development.
DATABASE_URL_DEVEL=postgresql://USER:PASSWORD@HOST:PORT/finch_development

# Supabase com dados reais. Nunca reutilize esta URL em testes automatizados.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/finch_production?sslmode=require

# Necessária apenas se o processo Rails production também oferecer o shard local.
DATABASE_URL_LOCAL=postgresql://USER:PASSWORD@HOST:PORT/finch_local

# Obrigatória para RSpec e comandos com RAILS_ENV=test.
# Deve apontar para um banco exclusivo cujo nome contenha "test".
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:PORT/finch_test?sslmode=require

# Opcional: segundo banco descartável para validar isolamento físico entre shards.
# Sem esta variável, ambos os pools de teste usam DATABASE_URL_TEST e continuam
# sem qualquer fallback para DATABASE_URL.
DATABASE_URL_TEST_SUPABASE=postgresql://USER:PASSWORD@HOST:PORT/finch_supabase_test?sslmode=require

# Operadores internos autorizados em cada banco. Os defaults correspondem ao
# ambiente pessoal atual, mas podem ser substituídos sem alterar código.
DATA_ENVIRONMENT_LOCAL_OPERATOR_EMAIL=homologacao@finch.local
DATA_ENVIRONMENT_SUPABASE_OPERATOR_EMAIL=joao@controle.local
